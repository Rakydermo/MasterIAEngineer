# API keys: una por cada proveedor que aparezca en LLM_MODEL o LLM_FALLBACK_MODEL
ANTHROPIC_API_KEY=test
OPENAI_API_KEY=test

# Modelo principal. El prefijo del proveedor es obligatorio: anthropic/... u openai/...
LLM_MODEL=anthropic/claude-haiku-4-5
# Modelo de respaldo (opcional). Se usa cuando el principal falla.
LLM_FALLBACK_MODEL=

# Presupuesto de tiempo por intento, en segundos
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=120
LLM_WRITE_TIMEOUT_S=10
LLM_POOL_TIMEOUT_S=5

# Reintentos contra el mismo despliegue. 0 = el fallback es el reintento
LLM_MAX_RETRIES=0
# Llamadas simultáneas al proveedor; al superarlo se responde 503
LLM_MAX_CONCURRENCY=8

# Entorno y logging
APP_ENV=development
LOG_LEVEL=INFO
